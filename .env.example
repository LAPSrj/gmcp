# Copy this file to .env and fill in the paths.
# Bun auto-loads .env when you run `bun run login` / `bun run start` / `bun test`,
# so you don't have to `export` these on every shell.
# (.env is in .gitignore — it will not be committed.)

# Required: path to the OAuth client JSON downloaded from Google Cloud Console
# (Credentials → Create OAuth client ID → Desktop app → Download JSON).
GMAIL_MCP_CREDENTIALS_FILE=/path/to/credentials.json

# Optional: profile name — used to scope multiple accounts on the same machine.
# When set, tokens land at ~/.config/gmail-mcp/tokens-<profile>.json instead
# of the default tokens.json. The CLI accepts a positional arg that takes
# precedence over this var: `bun run login work` → profile "work".
# Must match /^[a-zA-Z0-9_-]+$/.
# GMAIL_MCP_PROFILE=work

# Optional: override the token cache path explicitly. When set, this wins over
# the profile-derived path. Default: ~/.config/gmail-mcp/tokens.json (or
# tokens-<profile>.json when GMAIL_MCP_PROFILE is set).
# GMAIL_MCP_TOKEN_PATH=/path/to/tokens.json

# Optional: pin the loopback redirect port for the OAuth callback
# (random by default; only set this if your firewall requires a fixed port).
# GMAIL_MCP_REDIRECT_PORT=53682
