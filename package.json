{
  "name": "gmcp",
  "version": "0.1.0",
  "description": "MCP server for Gmail + Google Calendar (and read-only Google Contacts) — modelled on outlook-mcp",
  "type": "module",
  "private": true,
  "bin": {
    "gmail-mcp": "./src/server.ts",
    "gmail-mcp-auth": "./src/bin/auth.ts"
  },
  "scripts": {
    "start": "bun run src/server.ts",
    "auth": "bun run src/bin/auth.ts",
    "login": "bun run src/bin/auth.ts login",
    "status": "bun run src/bin/auth.ts status",
    "logout": "bun run src/bin/auth.ts logout",
    "profiles": "bun run src/bin/auth.ts list",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "google-auth-library": "^9.14.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
